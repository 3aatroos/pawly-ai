DB_HOST=localhost
DB_PORT=3306
DB_NAME=pawly_db
DB_USER=root
DB_PASSWORD=

# Get your key from https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-7b
MISTRAL_TEMPERATURE=0.3
MISTRAL_TIMEOUT=60

# Get a key from https://aistudio.google.com — never commit a real key here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=60

AI_SERVICE_PORT=8000

# Shared with Spring Boot. Leave empty in local development.
# Set the same value in AI_SERVICE_TOKEN for both processes. Never commit a real token.
AI_SERVICE_TOKEN=

# QLoRA recommendations: auto uses the adapter when the directory exists.
# QLORA_ENABLED=off forces the content-based fallback.
QLORA_ENABLED=auto
QLORA_ADAPTER_DIR=
QLORA_TIMEOUT_SECONDS=6
QLORA_FORCE_CPU=
